#!/bin/sh
# switch-theme -- select the active theme+mode and refresh the stable adapters.
#
# Usage:
#   switch-theme <theme> [dark|light|auto]
#
#   theme  one of the palettes in palettes/ (rosepine, nebula, ...)
#   mode   dark | light | auto   (default: keep the current mode, else dark)
#          auto = follow the OS appearance; the concrete dark/light choice is
#          resolved by the consumer (wezterm) at config-eval time. When mode is
#          auto, switch-theme materializes the CURRENT best guess into current.*
#          (dark) so tmux/nvim -- which cannot introspect OS appearance -- have
#          a sane target; wezterm overrides per its own get_appearance().
#
# What it does:
#   1. validates palettes/<theme>.json exists,
#   2. writes `active` with "<theme> <mode>",
#   3. renders generated adapters if any are missing (idempotent re-render),
#   4. refreshes the stable generated/current.* copies to point at the
#      selected <theme>-<resolved-mode>,
#   5. live-reloads tmux if a server is running.
#
# The current.* indirection keeps each tool's config dead simple: tmux/nvim/
# wezterm source a fixed filename and never need shell expansion. POSIX sh.

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PALETTES_DIR="$SCRIPT_DIR/palettes"
GEN_DIR="$SCRIPT_DIR/generated"
ACTIVE_FILE="$SCRIPT_DIR/active"
RENDER="$SCRIPT_DIR/render.sh"

usage() {
  cat <<EOF
Usage: switch-theme <theme> [dark|light|auto]

  theme   a palette name (see palettes/*.json)
  mode    dark | light | auto  (default: current mode, else dark)
EOF
}

theme=${1:-}
if [ -z "$theme" ]; then
  usage >&2
  exit 2
fi
case "$theme" in
  -h | --help)
    usage
    exit 0
    ;;
esac

pf="$PALETTES_DIR/$theme.json"
if [ ! -f "$pf" ]; then
  printf 'switch-theme: error: no such theme palette: %s\n' "$pf" >&2
  printf 'available:\n' >&2
  for p in "$PALETTES_DIR"/*.json; do
    [ -e "$p" ] || continue
    printf '  %s\n' "$(basename "$p" .json)" >&2
  done
  exit 1
fi

# Resolve the requested mode. If omitted, keep the current mode from `active`,
# defaulting to dark when there is no prior selection.
mode=${2:-}
if [ -z "$mode" ]; then
  if [ -f "$ACTIVE_FILE" ]; then
    mode=$(cut -d' ' -f2 "$ACTIVE_FILE" 2>/dev/null || echo dark)
    [ -n "$mode" ] || mode=dark
  else
    mode=dark
  fi
fi
case "$mode" in
  dark | light | auto) ;;
  *)
    printf 'switch-theme: error: mode must be dark, light, or auto (got: %s)\n' "$mode" >&2
    exit 2
    ;;
esac

# Write the active selection.
printf '%s %s\n' "$theme" "$mode" >"$ACTIVE_FILE"

# Ensure generated adapters exist for this theme (render if missing).
if [ ! -f "$GEN_DIR/$theme-dark.tmux.conf" ] || [ ! -f "$GEN_DIR/$theme-light.tmux.conf" ]; then
  if [ -x "$RENDER" ]; then
    sh "$RENDER" "$theme"
  else
    printf 'switch-theme: warning: render.sh not executable; skipping render\n' >&2
  fi
fi

# Resolve a concrete mode for the stable current.* copies. tmux and nvim cannot
# introspect OS appearance, so `auto` materializes as dark here; wezterm applies
# its own get_appearance() decision independently.
resolved_mode=$mode
[ "$resolved_mode" = auto ] && resolved_mode=dark

src_base="$GEN_DIR/$theme-$resolved_mode"
if [ ! -f "$src_base.tmux.conf" ]; then
  printf 'switch-theme: error: generated adapter missing: %s.tmux.conf\n' "$src_base" >&2
  printf '  run: sh %s %s\n' "$RENDER" "$theme" >&2
  exit 1
fi

# Refresh the stable current.* copies (copy, not symlink, for portability).
cp "$src_base.wezterm.lua" "$GEN_DIR/current.wezterm.lua"
cp "$src_base.tmux.conf" "$GEN_DIR/current.tmux.conf"
cp "$src_base.nvim.lua" "$GEN_DIR/current.nvim.lua"
mkdir -p "$GEN_DIR/current"
cp "$src_base/palette.sh" "$GEN_DIR/current/palette.sh"

printf 'active theme: %s %s' "$theme" "$mode"
[ "$mode" = auto ] && printf ' (materialized as %s for tmux/nvim)' "$resolved_mode"
printf '\n'

# Live-reload tmux if a server is running. Guarded so this is safe outside tmux.
if command -v tmux >/dev/null 2>&1; then
  if [ -n "${TMUX:-}" ] || tmux ls >/dev/null 2>&1; then
    conf="$HOME/.config/tmux/tmux.conf"
    [ -f "$conf" ] || conf="$HOME/.tmux.conf"
    if [ -f "$conf" ]; then
      tmux source-file "$conf" >/dev/null 2>&1 && printf 'tmux reloaded.\n' || \
        printf 'switch-theme: note: tmux source-file failed (server may have no config yet).\n' >&2
    fi
  fi
fi

printf 'wezterm and nvim pick up the change on next config reload / new window/buffer.\n'
